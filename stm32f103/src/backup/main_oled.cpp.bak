#include <Arduino.h>
#include "mylib.h"

OLED oled;

void setup() {
    oled.begin();
    oled.clear();
    oled.setFont(u8g2_font_5x7_tr);

    // แสดงข้อความ
    oled.print("Hello, World!", 0, 10);
    oled.println("Line 2", 0, 20);

    // อัปเดต buffer
    oled.update();
}

